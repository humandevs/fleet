# Fleet community coverage-collector configuration (ScreenConnect / Bitdefender / Action1).
#
# The collector reads these FLEET_COMMUNITY_* environment variables at startup. Fill in the values,
# then either:
#   • Appliance (fleet-test / fleet-prod): copy the values into the matching vault.yml keys — see the
#     "Appliance mapping" note at the bottom — so they render into /etc/fleet/fleet.env. Do NOT commit
#     a filled-in copy of this file (secrets); vault.yml is git-ignored for the same reason.
#   • Manual / direct run: rename to fleet.env and load it into the server's environment.
#
# The collector only REGISTERS when at least one provider is configured; ScreenConnect counts as
# configured once URL is set. With URL alone you get deployment-only mode (install commands, presence
# detection); add the API-Manager secret + path to also POLL remote-access coverage.

# =============================================================================
# ScreenConnect (ConnectWise Control) — remote access
# =============================================================================

# (1) Your self-hosted ScreenConnect base URL. REQUIRED. No trailing slash.
#     e.g. https://remote.yourcompany.com   (or https://yourcompany.com:8040 if not reverse-proxied)
FLEET_COMMUNITY_SCREENCONNECT_URL=

# (2) The "API Key" == the RESTful API Manager shared secret.
#     ScreenConnect's API auth is a SINGLE SECRET (sent in the CTRLAuthHeader header) — there is NO
#     username/password for this path. To get it: Admin -> Extensions -> install "RESTful API Manager",
#     set a long random RESTfulAuthenticationSecret (optionally lock RESTfulAllowedOrigin), and paste
#     that secret here. Leave blank for deployment-only mode (no coverage polling).
FLEET_COMMUNITY_SCREENCONNECT_ACCESS_SECRET=

# (3) OPTIONAL: the GetSessionsByFilter service path. The RESTful API Manager's extension GUID is FIXED
#     across every instance, so this DEFAULTS in code to
#       /App_Extensions/2d558935-686a-4bd0-9991-07539f5fe749/Service.ashx/GetSessionsByFilter
#     Leave blank unless a future extension version changes the path.
FLEET_COMMUNITY_SCREENCONNECT_API_PATH=

# (4) REQUIRED for polling: the GetSessionsByFilter argument — a ScreenConnect session-filter expression
#     scoping which sessions to pull. The API rejects an empty/null filter. Examples:
#       CustomProperty1 = 'TestFleet'   (a specific access group — CustomProperty1 is our group key)
#       SessionType = 'Access'          (ALL access agents — can be thousands on a busy server)
#     Leave blank for deployment-only mode (no coverage polling).
FLEET_COMMUNITY_SCREENCONNECT_SESSION_FILTER=

# (5) OUR ScreenConnect instance id — the 16-hex string in the installed service name
#     "ScreenConnect Client (<InstanceID>)". Used for local (osquery) presence detection so a competitor's
#     side-by-side ScreenConnect agent is never counted as ours. Find it in the admin console or as the
#     "(...)" suffix on an already-installed client. Optional (the API-poll path is already instance-scoped).
FLEET_COMMUNITY_SCREENCONNECT_INSTANCE_ID=

# NOTE ON "username": the collector needs no username — the RESTful API Manager authenticates with the
# secret above only. A username is only relevant if you instead use ScreenConnect's internal PageService
# API (HTTP Basic), which we avoid because it is version-fragile. If your setup truly requires a
# username-based credential, tell us and we'll add a username field to the provider — but the recommended
# RESTful API Manager path does not use one, so it's intentionally omitted here.

# =============================================================================
# Bitdefender GravityZone — AV / MDR  (leave blank for now; not in the current MVP)
# =============================================================================
# FLEET_COMMUNITY_BITDEFENDER_HOST=      # region host only, e.g. https://cloud.gravityzone.bitdefender.com
# FLEET_COMMUNITY_BITDEFENDER_API_KEY=   # Control Center API key scoped to include the Network API

# =============================================================================
# Action1 — patching  (leave blank for now; not in the current MVP)
# =============================================================================
# FLEET_COMMUNITY_ACTION1_BASE_URL=
# FLEET_COMMUNITY_ACTION1_CLIENT_ID=
# FLEET_COMMUNITY_ACTION1_CLIENT_SECRET=
# FLEET_COMMUNITY_ACTION1_ORG_ID=          # REQUIRED for Action1 to collect (id+secret alone won't register)

# -----------------------------------------------------------------------------
# Appliance mapping (fleet-test / fleet-prod): put these in
#   human/secrets/vault.yml   (git-ignored; see human/SECRETS.md — BACK IT UP off-machine)
# using the lower-cased keys the fleet.env.j2 template expects:
#   fleet_community_screenconnect_url:            "<URL>"
#   fleet_community_screenconnect_access_secret:  "<API Manager secret>"
#   fleet_community_screenconnect_session_filter: "CustomProperty1 = 'TestFleet'"   # required for polling
#   fleet_community_screenconnect_instance_id:    "<16-hex instance id>"            # optional (presence)
#   # fleet_community_screenconnect_api_path is OPTIONAL — the fixed-GUID default is used when omitted.
# Then re-run the playbook (or resync) so /etc/fleet/fleet.env is regenerated, and restart Fleet.
