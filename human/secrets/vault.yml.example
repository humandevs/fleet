# This is human/secrets/vault.yml.example. Copy to human/secrets/vault.yml and fill in.
# Encrypt:  ansible-vault encrypt human/secrets/vault.yml    NEVER commit the real vault.yml.
# The appliance firstboot AUTO-GENERATES vault.yml (private key + DB passwords) when it's absent —
# this example is for the manual / push-mode path. BACK IT UP off-machine — see human/SECRETS.md.

# Fleet server private key: encrypts MDM/integration secrets at rest in the DB. IRREPLACEABLE — losing it
# permanently locks those secrets. Generate 32 random bytes:  openssl rand -base64 32
fleet_server_private_key: "REPLACE_WITH_32_BYTE_BASE64"

# Per-appliance DB passwords (random). The deps role writes these into a docker-compose.override.yml so
# the runtime mysql service uses them instead of the published fleet/insecure + root/toor dev defaults.
# Generate:  openssl rand -hex 24   (MySQL applies them only on the FIRST init of an empty data volume.)
vault_mysql_password: "REPLACE_WITH_RANDOM_HEX"
vault_mysql_root_password: "REPLACE_WITH_RANDOM_HEX"

# --- Community coverage collector (optional) -------------------------------------------------------
# Uncomment + fill to enable a provider; the collector registers only when at least one is set. These
# render into /etc/fleet/fleet.env via roles/fleet/templates/fleet.env.j2. Full docs + how to obtain each
# value: human/setup/fleet-community.env.example.
#
# ScreenConnect (remote access). URL alone = deployment-only; add access_secret + api_path to poll coverage.
# The "API Key" is the RESTful API Manager shared secret (CTRLAuthHeader) — there is NO username.
# fleet_community_screenconnect_url:           "https://remote.yourcompany.com"
# fleet_community_screenconnect_access_secret: "REPLACE_WITH_RESTFUL_API_MANAGER_SECRET"
# fleet_community_screenconnect_api_path:      "/App_Extensions/REPLACE-GUID/Service.ashx/GetSessionsByFilter"
# fleet_community_screenconnect_instance_id:   "REPLACE_WITH_16_HEX_INSTANCE_ID"
