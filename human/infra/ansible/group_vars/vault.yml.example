# Copy to vault.yml and encrypt:  ansible-vault encrypt group_vars/vault.yml
# NEVER commit an unencrypted vault.yml. These map into fleet.env on the VM.

fleet_mysql_password: "REPLACE_ME"

# Fleet server private key: encrypts MDM/other secrets at rest in the DB. Generate 32 random bytes:
#   openssl rand -base64 32
fleet_server_private_key: "REPLACE_WITH_32_BYTE_BASE64"
