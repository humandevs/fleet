# Fleet appliance kickstart (Rocky 9) — unattended install + first-boot self-provision.
# Placeholders (@@...@@) are filled by Build-FleetAppliance.ps1. Anaconda auto-loads this when it's on a
# volume labeled OEMDRV named ks.cfg — no boot-param editing needed.

text
lang en_US.UTF-8
keyboard us
timezone Etc/UTC --utc

# Networking: DHCP, set the hostname.
network --bootproto=dhcp --device=link --activate --hostname=@@HOSTNAME@@

# Disk: wipe and auto LVM layout on the single VHDX.
zerombr
clearpart --all --initlabel
autopart --type=lvm
# quiet + low loglevel: keep kernel/systemd journal OFF the console (tty1) so the /etc/issue status
# banner (IP + Fleet status + URL) stays readable instead of being scrolled away by "Starting/Finished
# X" spam during the long provisioning build. Warnings/errors still print; full detail is in journalctl.
bootloader --location=mbr --append="quiet loglevel=3"

# Security + accounts. The admin user always gets a password (console + optional password SSH). An SSH key
# is added only if one was supplied (@@SSHKEY_LINE@@ is empty otherwise — see Build-FleetAppliance.ps1).
rootpw --lock
selinux --enforcing
firewall --enabled --service=ssh
user --name=@@USERNAME@@ --groups=wheel --plaintext --password=@@PASSWORD@@
@@SSHKEY_LINE@@
services --enabled=sshd

reboot --eject

# --ignoremissing: never halt the unattended install on a package the ISO's repos lack. git is NOT on the
# Rocky minimal ISO (it's in AppStream) and isn't needed at install time -- first boot installs it from the
# network repos (dnf install -y ansible-core git).
%packages --ignoremissing
@^minimal-environment
openssh-server
%end

# --- First-boot self-provision: install Ansible, clone the fork, run the playbook against localhost. ---
%post --log=/root/ks-post.log
set -eux

# passwordless sudo for the admin (key-based appliance)
echo "@@USERNAME@@ ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-fleet-appliance
chmod 0440 /etc/sudoers.d/90-fleet-appliance

# Harden SSH when a key was provisioned: an admin with NOPASSWD sudo is one guessed SSH password away
# from root on the box that holds /etc/fleet/fleet.env (DB creds, FLEET_SERVER_PRIVATE_KEY, every vendor
# API key). If the sshkey directive populated the admin's authorized_keys, disable password + root SSH
# (the Hyper-V console still has password login for recovery). Password-only appliances (no key supplied,
# @@SSHKEY_LINE@@ empty) keep password SSH so the operator isn't locked out.
if [ -s "/home/@@USERNAME@@/.ssh/authorized_keys" ]; then
  install -d -m 0755 /etc/ssh/sshd_config.d
  cat > /etc/ssh/sshd_config.d/50-fleet-appliance.conf <<'SSHD'
# Managed by the Fleet appliance kickstart: an SSH key was provisioned, so require key-based login.
PasswordAuthentication no
PermitRootLogin no
SSHD
  chmod 0644 /etc/ssh/sshd_config.d/50-fleet-appliance.conf
fi

install -d -m 0755 /usr/local/sbin
cat > /usr/local/sbin/fleet-firstboot.sh <<'FIRSTBOOT'
#!/bin/bash
# One-shot appliance provisioning. Logs to /var/log/fleet-firstboot.log.
set -euxo pipefail
exec > /var/log/fleet-firstboot.log 2>&1

# tar + gzip: NOT on the Rocky minimal install, but needed to extract the FLEETSRC source archive below.
dnf install -y ansible-core git tar gzip

# Hyper-V guest daemons so the HOST can report this VM's IP (Get-VMNetworkAdapter / Watch-FleetVM.ps1).
# Done first (before the long build) so the IP shows up on the host within a minute or two. Not on the
# minimal ISO, so it installs from the network here. Non-fatal if it fails.
dnf install -y hyperv-daemons && systemctl enable --now hypervkvpd || true

# Obtain the Fleet source into /opt/fleet-src. Prefer the LOCAL working tree delivered on the FLEETSRC ISO
# (private repo, captures uncommitted work — no repo network access); otherwise git-clone the remote.
FLEET_SRC=/opt/fleet-src
SRC_DEV=$(blkid -L FLEETSRC 2>/dev/null || true)
if [ -n "$SRC_DEV" ]; then
  mkdir -p /mnt/fleetsrc "$FLEET_SRC"
  mount -o ro "$SRC_DEV" /mnt/fleetsrc
  tar -xzf /mnt/fleetsrc/fleet-src.tar.gz -C "$FLEET_SRC"
  umount /mnt/fleetsrc
elif [ ! -f "$FLEET_SRC/go.mod" ]; then
  git clone --branch "@@BRANCH@@" "@@REPO@@" "$FLEET_SRC"
fi

cd "$FLEET_SRC/human/appliance/ansible"

# Generate this appliance's unique secrets once, into the git-ignored human/secrets/ tree (NOT
# group_vars) so they're obvious and easy to back up. BACK THEM UP off-machine (human/SECRETS.md):
# losing fleet_server_private_key permanently locks every secret this Fleet encrypts at rest.
# TODO (per human/SECRETS.md): the build should PROMPT for / hand back these secrets so the operator
# takes custody; auto-generating here is the interim.
SECRETS_DIR="$FLEET_SRC/human/secrets"
if [ ! -f "$SECRETS_DIR/vault.yml" ]; then
  umask 077
  mkdir -p "$SECRETS_DIR"
  {
    echo "fleet_server_private_key: \"$(openssl rand -base64 32)\""
    # Random DB creds so the box never runs the published fleet/insecure + root/toor dev defaults.
    # hex (alphanumeric) is safe unquoted in compose ${VAR} and the systemd EnvironmentFile. NOTE:
    # MySQL applies these only on the FIRST init of an empty data volume.
    echo "vault_mysql_password: \"$(openssl rand -hex 24)\""
    echo "vault_mysql_root_password: \"$(openssl rand -hex 24)\""
  } > "$SECRETS_DIR/vault.yml"
fi

ansible-galaxy collection install -r requirements.yml
ansible-playbook -i inventory/localhost.ini site.yml

# Smoke check: don't let the caller mark this appliance "provisioned" until Fleet actually answers on
# :8080. Exiting non-zero here means systemd's ExecStartPost (which touches .provisioned) does NOT run, so
# a failed build stays visible and re-attempts on the next boot instead of looking done.
echo "Smoke check: waiting for Fleet /healthz on :8080 ..."
for i in $(seq 1 60); do
  if curl -fsk https://127.0.0.1:8080/healthz >/dev/null 2>&1; then
    echo "Smoke check PASSED — Fleet is healthy."
    exit 0
  fi
  sleep 5
done
echo "Smoke check FAILED — Fleet did not answer /healthz within ~5m. See 'systemctl status fleet'." >&2
exit 1
FIRSTBOOT
chmod 0755 /usr/local/sbin/fleet-firstboot.sh

cat > /etc/systemd/system/fleet-firstboot.service <<'UNIT'
[Unit]
Description=Fleet appliance first-boot provisioning
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/fleet-appliance/.provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fleet-firstboot.sh
ExecStartPost=/usr/bin/mkdir -p /var/lib/fleet-appliance
ExecStartPost=/usr/bin/touch /var/lib/fleet-appliance/.provisioned

[Install]
WantedBy=multi-user.target
UNIT

systemctl enable fleet-firstboot.service

# --- Console banner: show IP + Fleet status + management URL on /etc/issue (the console pre-login screen),
# so you can read how to reach Fleet by just opening the VM console -- no login or commands needed. ---
cat > /usr/local/sbin/fleet-console-banner.sh <<'BANNER'
#!/bin/bash
IP=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')
[ -z "$IP" ] && IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$IP" ] && IP="(acquiring...)"
if systemctl is-active --quiet fleet && curl -fsk https://127.0.0.1:8080/healthz >/dev/null 2>&1; then
  ST="running (healthy)"
elif systemctl is-active --quiet fleet-firstboot 2>/dev/null || systemctl is-active --quiet fleet-personalize 2>/dev/null; then
  ST="provisioning (building Fleet, ~15 min)..."
else
  ST="NOT running -- ssh in and: sudo journalctl -u fleet -n 50"
fi
NEW=$(mktemp)
{
  echo ""
  echo "  ==============================================="
  echo "   Fleet CE+ appliance  --  $(hostname)"
  echo "   IP address : ${IP}"
  echo "   Fleet      : ${ST}"
  echo "   Manage at  : https://${IP}:8080"
  echo "   Login      : @@USERNAME@@   (or:  ssh @@USERNAME@@@${IP})"
  echo "  ==============================================="
  echo ""
} > "$NEW"
if ! cmp -s "$NEW" /etc/issue 2>/dev/null; then
  cp "$NEW" /etc/issue
  # re-render the console prompt so new info shows without a keypress -- only when nobody is on tty1.
  who 2>/dev/null | grep -q 'tty1' || systemctl restart getty@tty1 2>/dev/null || true
fi
rm -f "$NEW"
BANNER
chmod 0755 /usr/local/sbin/fleet-console-banner.sh

cat > /etc/systemd/system/fleet-banner.service <<'SVC'
[Unit]
Description=Fleet console banner (IP + status + URL)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fleet-console-banner.sh
SVC

cat > /etc/systemd/system/fleet-banner.timer <<'TMR'
[Unit]
Description=Refresh the Fleet console banner
[Timer]
OnBootSec=10
OnUnitActiveSec=30
AccuracySec=5
[Install]
WantedBy=timers.target
TMR

systemctl enable fleet-banner.timer
%end
