# Copy to .env and fill with STRONG RANDOM values (never commit the real .env). The README's one-liner
# generates these for you. All are required -- compose fails if any is missing.

# MySQL root + app-user passwords (28+ random chars)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Fleet server private key -- encrypts secrets at rest. EXACTLY 32 characters.
FLEET_SERVER_PRIVATE_KEY=

# Optional: run your fork's image instead of official (default fleetdm/fleet:latest)
# FLEET_IMAGE=yourorg/fleet:ceplus
