# Managed by Ansible.
[Unit]
Description=Fleet (Human-ISM fork)
After=network-online.target redis.service
Wants=network-online.target
# If Fleet fails repeatedly (e.g. DB not up, missing binary), STOP retrying instead of crash-looping every
# few seconds and flooding the console. After 4 failures in 2 min systemd gives up (failed state) -- quiet,
# and 'systemctl status fleet' shows why. Re-arm with 'systemctl reset-failed fleet; systemctl start fleet'.
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
User={{ fleet_service_user }}
Group={{ fleet_service_user }}
EnvironmentFile={{ fleet_config_dir }}/fleet.env
ExecStart={{ fleet_bin }} serve
Restart=on-failure
RestartSec=15
# Fleet is stateless on disk; keep it locked down. PrivateTmp gives it a writable private /tmp
# (ProtectSystem=strict makes the real one read-only); the log dir holds the osquery filesystem
# loggers (see fleet.env).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ fleet_config_dir }} {{ fleet_log_dir }}

[Install]
WantedBy=multi-user.target
