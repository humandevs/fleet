# Managed by Ansible. Fleet server config (env-var form of the serve flags).
FLEET_MYSQL_ADDRESS={{ fleet_mysql_address }}
FLEET_MYSQL_DATABASE={{ fleet_mysql_database }}
FLEET_MYSQL_USERNAME={{ fleet_mysql_username }}
FLEET_MYSQL_PASSWORD={{ fleet_mysql_password }}

FLEET_REDIS_ADDRESS={{ fleet_redis_address }}

FLEET_SERVER_ADDRESS={{ fleet_server_address }}
FLEET_SERVER_CERT={{ fleet_tls_dir }}/fleet.crt
FLEET_SERVER_KEY={{ fleet_tls_dir }}/fleet.key

# Encrypts MDM/integration secrets at rest in the DB (see human/RISK-REGISTER.md).
FLEET_SERVER_PRIVATE_KEY={{ fleet_server_private_key }}

FLEET_LOGGING_JSON=true

# Fleet's filesystem logger defaults to /tmp, which the hardened unit makes read-only — point it
# at the dedicated log dir instead (created by the role, ReadWritePaths in the unit).
FLEET_FILESYSTEM_STATUS_LOG_FILE={{ fleet_log_dir }}/osquery_status.log
FLEET_FILESYSTEM_RESULT_LOG_FILE={{ fleet_log_dir }}/osquery_result.log

# --- Community host-status collector (MIT; server/community/) ---
# Credentials live in human/secrets/vault.yml; each provider block renders only when its key is set,
# so a fresh appliance without creds skips the collector cron entirely.
{% if fleet_community_splashtop_api_key is defined %}
FLEET_COMMUNITY_SPLASHTOP_API_KEY={{ fleet_community_splashtop_api_key }}
{% endif %}
{% if fleet_community_screenconnect_url is defined %}
FLEET_COMMUNITY_SCREENCONNECT_URL={{ fleet_community_screenconnect_url }}
FLEET_COMMUNITY_SCREENCONNECT_ACCESS_SECRET={{ fleet_community_screenconnect_access_secret | default('') }}
FLEET_COMMUNITY_SCREENCONNECT_API_PATH={{ fleet_community_screenconnect_api_path | default('') }}
FLEET_COMMUNITY_SCREENCONNECT_SESSION_FILTER={{ fleet_community_screenconnect_session_filter | default('') }}
FLEET_COMMUNITY_SCREENCONNECT_INSTANCE_ID={{ fleet_community_screenconnect_instance_id | default('') }}
{% endif %}
{% if fleet_community_bitdefender_host is defined and fleet_community_bitdefender_api_key is defined %}
FLEET_COMMUNITY_BITDEFENDER_HOST={{ fleet_community_bitdefender_host }}
FLEET_COMMUNITY_BITDEFENDER_API_KEY={{ fleet_community_bitdefender_api_key }}
{% endif %}
